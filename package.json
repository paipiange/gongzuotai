{
  "name": "dsh-paipiange",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:preview": "vite build",
    "build:plugin": "tsdown",
    "build": "pnpm typecheck && pnpm build:preview && pnpm build:plugin",
    "test": "vitest run",
    "prepack": "pnpm build:plugin",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build:plugin",
    "release": "pnpm typecheck && pnpm test && pnpm build:plugin && npm pack --pack-destination .artifacts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/fiber": "8.18.0",
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "@remotion/three": "4.0.542",
    "better-sqlite3": "12.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.542",
    "three": "^0.170.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "tsdown": "^0.17.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
